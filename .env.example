# Copie para .env.local (nunca faça commit de .env.local).

# Painel de administração
ADMIN_PASSWORD=                # palavra-passe de acesso a /admin
SESSION_SECRET=                # texto aleatório com 32+ caracteres (ex.: openssl rand -base64 48)

# Firebase Admin (chave de serviço: Firebase Console > Definições do projeto > Contas de serviço)
# Opção 1: JSON completo numa só linha
FIREBASE_SERVICE_ACCOUNT_KEY=
# Opção 2: variáveis separadas (a chave privada com \n literais)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary (documentos e imagens)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
